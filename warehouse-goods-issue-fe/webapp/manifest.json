{
  "_version": "1.89.0",
  "sap.app": {
    "id": "warehousegoodsissuefe",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "be150a76-bd00-49cf-8ccd-c7068c6ec9b3"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "warehousegoodsissuefe.i18n.i18n",
          "supportedLocales": [
            "",
            "en"
          ],
          "fallbackLocale": "en"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "warehousegoodsissuefe.view",
        "async": true,
        "viewPath": "warehousegoodsissuefe.view"
      },
      "routes": [
        {
          "name": "RouteView",
          "pattern": ":?query:",
          "target": [
            "TargetView"
          ]
        },
        {
          "name": "RouteDetails",
          "pattern": "Details/{issueId}",
          "target": [
            "TargetDetails"
          ]
        },
        {
          "name": "RouteItemDetails",
          "pattern": "Details/{issueId}/Item/{itemId}",
          "target": [
            "TargetItemDetails"
          ]
        }
      ],
      "targets": {
        "TargetView": {
          "id": "View",
          "name": "View"
        },
        "TargetDetails": {
          "id": "Details",
          "name": "Details"
        },
        "TargetItemDetails": {
          "id": "ItemDetails",
          "name": "ItemDetails"
        }
      }
    },
    "rootView": {
      "viewName": "warehousegoodsissuefe.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}